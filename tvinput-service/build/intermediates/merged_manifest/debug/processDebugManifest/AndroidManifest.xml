<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gravarty.htsp.tvinput" >

    <uses-sdk android:minSdkVersion="26" />

    <uses-feature
        android:name="android.software.live_tv"
        android:required="true" />

    <application>
        <activity
            android:name="com.gravarty.htsp.tvinput.HtspSetupActivity"
            android:exported="true"
            android:label="@string/hts_setup_label"
            android:theme="@style/Theme.Wizard.Setup" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.gravarty.htsp.tvinput.HtspSettingsActivity"
            android:exported="true"
            android:label="@string/pref_screen_title"
            android:theme="@style/Theme.Preferences" />
        <activity
            android:name="com.gravarty.htsp.tvinput.HtspLoginActivity"
            android:exported="false"
            android:label="Tvheadend-Server"
            android:theme="@style/Theme.Wizard.Account" />

        <service
            android:name="com.gravarty.htsp.tvinput.HtspTvInputService"
            android:exported="true"
            android:label="HTS Television"
            android:permission="android.permission.BIND_TV_INPUT" >
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>

            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/tv_input_service" />
        </service>

        <!-- Radio channels as their own input (pvr.hts CHANNEL_TYPE_RADIO) -->
        <service
            android:name="com.gravarty.htsp.tvinput.HtspRadioInputService"
            android:exported="true"
            android:label="HTS Radio"
            android:permission="android.permission.BIND_TV_INPUT" >
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>

            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/tv_input_service" />
        </service>
    </application>

</manifest>